        // Element descriptions are document shapes. References below are application-level IDs.
        desktopArtist = element "Desktop / catalog_artists" "LiteDB collection" "_id: ArtistId (Guid). LibraryId: Guid. SourceRevision: Int64. Name and SortName: string." "Desktop LiteDB Entity"
        desktopAlbum = element "Desktop / catalog_albums" "LiteDB collection" "_id: AlbumId (Guid). LibraryId: Guid. AlbumArtistId: Guid?. SourceRevision: Int64. Title and SortTitle: string." "Desktop LiteDB Entity"
        desktopTrack = element "Desktop / catalog_tracks" "LiteDB collection" "_id: TrackId (Guid). LibraryId: Guid. ArtistId and AlbumId: Guid?. SourceRevision: Int64. Title: string. RelativePath and Genre: string?. TrackNumber and Rating: Int32?. DurationTicks: Int64?. Tags: versioned tag document." "Desktop LiteDB Entity"
        desktopPlaylist = element "Desktop / catalog_playlists" "LiteDB collection" "_id: PlaylistId (Guid). LibraryId: Guid. SourceRevision and PlaylistRevision: Int64. Name: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Desktop LiteDB Entity"
        desktopListening = element "Desktop / listening_records" "LiteDB collection" "_id: PlayId or (LibraryId, ListenerId, TrackId) for favorites, distinguished by kind. LibraryId, ListenerId and TrackId: Guid. Kind: Play or Favorite. SourceRevision: Int64. PlayedAtUtc: DateTime for plays." "Desktop LiteDB Entity"
        desktopSharedPreference = element "Desktop / shared_preference_cache" "LiteDB collection" "_id: (LibraryId, PreferenceKey). LibraryId: Guid. PreferenceKey: string. RegistryVersion: Int32. SourceRevision: Int64. Value: registry-typed value." "Desktop LiteDB Entity"
        desktopDraft = element "Desktop / playlist_drafts" "LiteDB collection" "_id: DraftId (Guid). PlaylistId: Guid?. ExpectedHostRevision: Int64?. DraftRevision: Int64. ProposedName: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Desktop LiteDB Entity"
        desktopPlayback = element "Desktop / playback_sessions" "LiteDB collection" "_id: SessionId (Guid). CheckpointRevision, QueueRevision and PositionTicks: Int64. ActiveEntryId: Guid?. Shuffle: Boolean. Repeat: string enum. Queue: ordered { EntryId: Guid, TrackId: Guid } list. PlaylistBacking: optional { PlaylistId: Guid, Revision: Int64, Name: string, LastSave: operation key? }." "Desktop LiteDB Entity"
        desktopOverride = element "Desktop / preference_overrides" "LiteDB collection" "_id: PreferenceKey (string). RegistryVersion: Int32. LocalRevision: Int64. Value: registry-typed value." "Desktop LiteDB Entity"
        desktopOperation = element "Desktop / pending_operations" "LiteDB collection" "_id: (OriginInstanceId, OperationId). Both IDs: Guid. CommandType and State: string. Payload: versioned intent and receipt. ExpectedRevision: Int64?. DraftId and QueueSessionId: Guid?. A queue save payload carries queue revision, intent hash, predecessor key and revision pin state." "Desktop LiteDB Entity"
        desktopCheckpoint = element "Desktop / sync_checkpoints" "LiteDB collection" "_id: (LibraryId, Feed). LibraryId: Guid. Feed: string. AppliedRevision: Int64. Cursor: string?." "Desktop LiteDB Entity"
        desktopSchema = element "Desktop / store_schema" "LiteDB collection" "_id: singleton 'store'. StoreId: Guid. StoreRole: Desktop. SchemaVersion: Int32." "Desktop LiteDB Entity"

        hostArtist = element "Host / catalog_artists" "LiteDB collection" "_id: ArtistId (Guid). LibraryId: Guid. Revision: Int64. Name and SortName: string." "Host LiteDB Entity"
        hostAlbum = element "Host / catalog_albums" "LiteDB collection" "_id: AlbumId (Guid). LibraryId: Guid. AlbumArtistId: Guid?. Revision: Int64. Title and SortTitle: string." "Host LiteDB Entity"
        hostTrack = element "Host / catalog_tracks" "LiteDB collection" "_id: TrackId (Guid). LibraryId: Guid. ArtistId and AlbumId: Guid?. Revision: Int64. BeetsTrackId: Int64?. Title: string. RelativePath and Genre: string?. TrackNumber and Rating: Int32?. DurationTicks: Int64?. Tags: versioned tag document." "Host LiteDB Entity"
        hostPlaylist = element "Host / saved_playlists" "LiteDB collection" "_id: PlaylistId (Guid). LibraryId: Guid. Revision: Int64. Name: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Host LiteDB Entity"
        hostListening = element "Host / listening_records" "LiteDB collection" "_id: PlayId or (LibraryId, ListenerId, TrackId) for favorites, distinguished by kind. LibraryId, ListenerId and TrackId: Guid. Kind: Play or Favorite. Revision: Int64. PlayedAtUtc: DateTime for plays." "Host LiteDB Entity"
        hostPreference = element "Host / shared_preferences" "LiteDB collection" "_id: (LibraryId, PreferenceKey). LibraryId: Guid. PreferenceKey: string. RegistryVersion: Int32. Revision: Int64. Value: registry-typed value." "Host LiteDB Entity"
        hostInstance = element "Host / registered_instances" "LiteDB collection" "_id: InstanceId (Guid). LibraryId: Guid. Role and Status: string. SyncthingDeviceId and PendingMediaPairing: string?. AndroidExport: optional { Revision: Int64, ShareId and ReceiverEndpoint: string, CaseSensitivePaths: Boolean, ReceiverRoot, ApprovedSenderId and InitialProfileId: string?, InitialProfileRevision: Int64?, ReceiverAcceptedAtOffer: Boolean?, ReceiverSharePhase and ReceiverFailureCode: string? }." "Host LiteDB Entity"
        hostJob = element "Host / library_jobs" "LiteDB collection" "_id: JobId (Guid). OriginInstanceId and OperationId: Guid. Kind and Status: string. UploadId: Guid?. ExpectedRevision and PublishedRevision: Int64?." "Host LiteDB Entity"
        hostReceipt = element "Host / operation_receipts" "LiteDB collection" "_id: (OriginInstanceId, OperationId). Both IDs: Guid. IntentFingerprint: string. Receipt: typed, versioned outcome." "Host LiteDB Entity"
        hostRevision = element "Host / revision_heads" "LiteDB collection" "_id: LibraryId (Guid). CurrentRevision and MinRetainedRevision: Int64." "Host LiteDB Entity"
        hostChange = element "Host / revision_changes" "LiteDB collection" "_id: (LibraryId, Revision). LibraryId, OriginInstanceId and OperationId: Guid. Revision: Int64. Changes: versioned entity updates or tombstones." "Host LiteDB Entity"
        hostDelivery = element "Host / notification_deliveries" "LiteDB collection" "_id: (LibraryId, RecipientInstanceId, Revision). Both IDs: Guid. Revision: Int64. Status: Pending or Acknowledged." "Host LiteDB Entity"
        hostExport = element "Host / device_exports" "LiteDB collection" "_id: ExportId (Guid). LibraryId and DeviceId: Guid. ScopeKey: unique library, device and profile key. ShareId and ProfileId: string. ProfileVersion and ManifestRevision (staged revision): Int64. CaseSensitivePaths: Boolean. PublicationState: string. PreparedPreviewIdentity: optional SHA-256 digest of the private preview descriptor." "Host LiteDB Entity"
        hostExportEntry = element "Host / device_export_entries" "LiteDB collection" "_id: (ExportId, hash(PathKey)). ExportId, EntryId and SourceEntityId: Guid. RelativePath and PathKey: string. Ordinal: Int32. SourceKind: Playlist or Audio. Playlist: Format, ContentIdentity and ordered { TrackId, Destination, AudioStatus } references. Audio: AudioStatus and optional IsDirect: Boolean." "Host LiteDB Entity"
        hostExportManifest = element "Host / device_export_manifests" "LiteDB collection" "_id: (LibraryId, DeviceId, hash(ShareId)). LibraryId, DeviceId and PublicationId: Guid. ShareId: string. Revision: Int64. Active layout: ProfileId and ProfileRevision, optional on legacy manifests." "Host LiteDB Entity"
        hostExportOwnedFile = element "Host / device_export_owned_files" "LiteDB collection" "_id: (ManifestKey, hash(PathKey)). ManifestKey, PathKey, RelativePath and ContentIdentity: string. SourceEntityId: Guid. SourceKind: Int32." "Host LiteDB Entity"
        hostExportJournal = element "Host / device_export_publication_journal" "LiteDB collection" "_id: PublicationId (Guid). ManifestKey: unique share scope. LibraryId, DeviceId, PlanId, OriginInstanceId and OperationId: Guid. ProfileId: string. PlanRevision, ProfileRevision and ManifestRevision: Int64. Destination: receiver registration snapshot. NextStep, StepCount and OwnedFileCount: Int32. LayoutEntryCount: optional Int32. NextProfileId and NextProfileRevision: optional reviewed assignment committed after file effects." "Host LiteDB Entity"
        hostExportJournalItem = element "Host / device_export_publication_items" "LiteDB collection" "_id: (PublicationId, Kind, Ordinal). PublicationId: Guid. Kind: Step, NextOwned or LayoutEntry. Ordinal: Int32. Payload: versioned file operation, owned file, or reviewed staged entry and playlist digest." "Host LiteDB Entity"
        hostExportScan = element "Host / device_export_scans" "LiteDB collection" "_id: TransferId (the PublicationId, Guid). ManifestKey: registered share scope. LibraryId and PlanId: Guid. PlanRevision, ManifestRevision and Revision: Int64. Destination: receiver registration snapshot. State: queued, awaiting receiver, completed, blocked, or superseded. Attempts and optional ItemCount: Int32. BytesVerified, optional TotalBytes, DueUtcTicks and optional LeaseUntilUtcTicks: Int64. Optional LeaseId and FailureCode." "Host LiteDB Entity"
        hostExportScanItem = element "Host / device_export_scan_items" "LiteDB collection" "_id: (TransferId, hash(Path)). TransferId: Guid. Path: string. ContentIdentity: SHA-256 of the requested file, or null for removal. Bytes and Version: optional sender index evidence pinned before observing the receiver." "Host LiteDB Entity"
        hostPcMirrorState = element "Host / pc_mirror_states" "LiteDB collection" "_id: LibraryId (Guid). Revision: Int64 for the projection. Observations: by ShareId, with native scope fingerprint, control revision, connection generation, last verified status and progress, and optional pending operation key." "Host LiteDB Entity"
        hostSchema = element "Host / store_schema" "LiteDB collection" "_id: singleton 'store'. StoreId: Guid. StoreRole: Host. SchemaVersion: Int32." "Host LiteDB Entity"

        desktopAlbum -> desktopArtist "Optional AlbumArtistId"
        desktopTrack -> desktopArtist "Optional ArtistId"
        desktopTrack -> desktopAlbum "Optional AlbumId"
        desktopPlaylist -> desktopTrack "Ordered entries by TrackId"
        desktopListening -> desktopTrack "TrackId"
        desktopDraft -> desktopPlaylist "Optional target PlaylistId"
        desktopDraft -> desktopTrack "Ordered draft entries by TrackId"
        desktopPlayback -> desktopTrack "Ordered queue entries by TrackId"
        desktopOperation -> desktopDraft "Optional DraftId retained for reconciliation"
        desktopOperation -> desktopPlayback "Optional QueueSessionId for ordered auto-save replay"
        desktopCheckpoint -> desktopArtist "Commits with the applied artist page"
        desktopCheckpoint -> desktopAlbum "Commits with the applied album page"
        desktopCheckpoint -> desktopTrack "Commits with the applied track page"
        desktopCheckpoint -> desktopPlaylist "Commits with the applied playlist page"
        desktopCheckpoint -> desktopListening "Commits with the applied listening records"
        desktopCheckpoint -> desktopSharedPreference "Commits with the applied shared defaults"
        desktopOverride -> desktopSharedPreference "Resolves the next preference source by key"

        hostAlbum -> hostArtist "Optional AlbumArtistId"
        hostTrack -> hostArtist "Optional ArtistId"
        hostTrack -> hostAlbum "Optional AlbumId"
        hostPlaylist -> hostTrack "Ordered entries by TrackId"
        hostListening -> hostTrack "TrackId"
        hostJob -> hostInstance "OriginInstanceId"
        hostJob -> hostReceipt "Submission receipt by origin and operation ID"
        hostJob -> hostChange "PublishedRevision when reconciled"
        hostReceipt -> hostInstance "OriginInstanceId"
        hostReceipt -> hostChange "Feed revision in a playlist save receipt"
        hostReceipt -> hostExport "Plan ID and original plan revision in a device staging receipt"
        hostChange -> hostRevision "LibraryId and issued revision"
        hostChange -> hostPlaylist "Versioned playlist updates and tombstones"
        hostDelivery -> hostChange "LibraryId and revision to deliver"
        hostDelivery -> hostInstance "RecipientInstanceId"
        hostExport -> hostInstance "Registered DeviceId"
        hostExportEntry -> hostExport "ExportId"
        hostExportEntry -> hostPlaylist "SourceEntityId when SourceKind is Playlist"
        hostExportEntry -> hostTrack "SourceEntityId when SourceKind is Audio"
        hostExportManifest -> hostInstance "Registered DeviceId"
        hostExportOwnedFile -> hostExportManifest "ManifestKey"
        hostExportOwnedFile -> hostPlaylist "SourceEntityId when SourceKind is Playlist"
        hostExportOwnedFile -> hostTrack "SourceEntityId when SourceKind is Audio"
        hostExportJournal -> hostExport "PlanId and recorded plan revision"
        hostExportJournal -> hostExportManifest "ManifestKey and base ownership revision"
        hostExportJournalItem -> hostExportJournal "PublicationId"
        hostExportScan -> hostExportManifest "ManifestKey and queued ownership revision"
        hostExportScan -> hostExport "PlanId and published plan revision"
        hostExportScanItem -> hostExportScan "TransferId and exact published effects"
        hostReceipt -> hostExportJournal "Reservation receipt before file effects"
        hostReceipt -> hostExportManifest "Committed device publication and manifest revision"
        hostReceipt -> hostPcMirrorState "Pending and completed PC mirror controls"
        hostReceipt -> hostInstance "Pairing reservation key and the committed Android export binding"
        hostPcMirrorState -> hostInstance "Directory revision advances with changes in verified Android folder status"
