        // Element descriptions are document shapes. References below are application-level IDs.
        desktopArtist = element "Desktop / catalog_artists" "LiteDB collection" "_id: ArtistId (Guid). LibraryId: Guid. SourceRevision: Int64. Name and SortName: string." "Desktop LiteDB Entity"
        desktopAlbum = element "Desktop / catalog_albums" "LiteDB collection" "_id: AlbumId (Guid). LibraryId: Guid. AlbumArtistId: Guid?. SourceRevision: Int64. Title and SortTitle: string." "Desktop LiteDB Entity"
        desktopTrack = element "Desktop / catalog_tracks" "LiteDB collection" "_id: TrackId (Guid). LibraryId: Guid. ArtistId and AlbumId: Guid?. SourceRevision: Int64. Title, SortTitle, RelativePath and Genre: string?. TrackNumber, DiscNumber, Year, and Rating: Int32?. DurationTicks: Int64?. TagAlbum and TagAlbumArtist: optional string overrides. An omitted override inherits the album value and an explicit null clears it." "Desktop LiteDB Entity"
        desktopPlaylist = element "Desktop / catalog_playlists" "LiteDB collection" "_id: PlaylistId (Guid). LibraryId: Guid. SourceRevision and PlaylistRevision: Int64. Name: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Desktop LiteDB Entity"
        desktopListening = element "Desktop / listening_records" "LiteDB collection" "_id: stable PlayId or derived library and track Guid for favorites. LibraryId, ListenerId and TrackId: Guid. The shared profile is the library ID. Kind: Play or Favorite. SourceRevision: Int64. PlayedAtUtcTicks: Int64 for plays. Deleted: Boolean on retained tombstones." "Desktop LiteDB Entity"
        desktopSharedPreference = element "Desktop / shared_preference_cache" "LiteDB collection" "_id: Guid derived from library and preference key. LibraryId: Guid. Kind: SharedDefault. PreferenceKey: string. RegistryVersion: Int32. SourceRevision: Int64. Live records contain exactly one of DurationTicks: Int64, Flag: Boolean, or Text: string. Deleted: Boolean on retained tombstones." "Desktop LiteDB Entity"
        desktopDraft = element "Desktop / playlist_drafts" "LiteDB collection" "_id: DraftId (Guid). PlaylistId: Guid?. ExpectedHostRevision: Int64?. DraftRevision: Int64. ProposedName: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Desktop LiteDB Entity"
        desktopPlayback = element "Desktop / playback_sessions" "LiteDB collection" "_id: SessionId (Guid). CheckpointRevision, QueueRevision and PositionTicks: Int64. ActiveEntryId: Guid?. WasPlaying: Boolean, absent on older checkpoints and then read as false. ActivePlay: optional {PlayId, TrackId, QueueEntryId} for the open primary occurrence. Shuffle: Boolean. Repeat: string enum. Queue: ordered { EntryId: Guid, TrackId: Guid } list. PlaylistBacking: optional { PlaylistId: Guid, Revision: Int64, Name: string, LastSave: direct operation key?, StagedSave: optional { OperationId and BatchId: Guid, Revision: Int64, Position: Int32 } }." "Desktop LiteDB Entity"
        desktopOverride = element "Desktop / preference_overrides" "LiteDB collection" "_id: PreferenceKey (string). RegistryVersion: Int32. LocalRevision: Int64. Value: registry-typed value. The playback restart toggle is Boolean and local only. Automatic fade duration uses Int64 ticks. Appearance theme uses canonical text. Null retains the local revision after an override is cleared." "Desktop LiteDB Entity"
        desktopShortcuts = element "Desktop / shortcut_bindings" "LiteDB collection" "_id: singleton 'local'. RegistryVersion: Int32. Revision: Int64. Overrides: { ActionId, Scope, Gesture } entries keyed by scope and action with canonical gesture values. Actual OS registrations use a separate runtime revision." "Desktop LiteDB Entity"
        desktopPluginRegistry = element "Desktop / plugin_registry" "LiteDB collection" "_id: singleton 'local'. Revision: Int64. Versions: entries keyed by PluginId and Version with MinimumProtocol and MaximumProtocol: Int32, EntryPoint and ArchiveSha256: string, Trust: enum, Enabled: Boolean, and Contributions { Id, Kind, HostAction?: string, Panel?: { Title, ActionId, Fields [{ Id, Label, Kind, Required, MaximumLength }] } }. Local only." "Desktop LiteDB Entity"
        desktopOperation = element "Desktop / pending_operations" "LiteDB collection" "_id: (OriginInstanceId, OperationId), both Guid. CommandType and State: string. State index supports pending named saves. SavePlaylist adds DraftId and QueueSessionId: Guid?, ExpectedRevision: Int64?, and BSON Payload with Version: Int32, DraftRevision: Int64, PlaylistId: Guid?, Name: string, Entries: ordered EntryId and TrackId pairs, CommittedPlaylistId: Guid?, CommittedRevision and CommittedDraftRevision: Int64?. QueueSource optionally holds QueueRevision: Int64, IntentHash: string, Predecessor: operation key?, and ExpectedRevisionPinned: Boolean. ConflictCode: string?, ActualHostRevision: Int64?, and Issues: { Code: string, Field: string? } list. Listener operations use LibraryId and RecordId: Guid, Predecessor: Guid?, indexed ListenerScope and ListenerRecordKey: string, Order and optional ReceiptRevision: Int64, optional RevisionPinned: Boolean, immutable OriginalPayload and pinned Payload JSON, and conflict or resolution fields. ResolutionIntent: optional JSON. ResolutionOperationId: Guid?." "Desktop LiteDB Entity"
        desktopBatchMode = element "Desktop / library_batch_modes" "LiteDB collection" "_id: (LibraryId, OriginInstanceId). Both IDs: Guid. Payload JSON: BatchId and ReviewId: Guid?, Revision: Int64, ChangeCount: Int32, and optional Seal with the approved Command and commit OperationId." "Desktop LiteDB Entity"
        desktopBatchEntry = element "Desktop / library_batch_entries" "LiteDB collection" "_id: (LibraryId, OriginInstanceId, BatchId, Position). BatchKey: scope and BatchId. OperationId: Guid. Position: Int32. Payload JSON: typed tag, import, organize, remove, or playlist change in review order. Maintenance retains the plan ID, ordered track IDs, catalog revision and exact paths, with explicit removal mode when applicable." "Desktop LiteDB Entity"
        desktopBatchReceipt = element "Desktop / library_batch_receipts" "LiteDB collection" "_id: (LibraryId, OriginInstanceId, OperationId). All IDs: Guid. Kind: Stage, Commit, or Direct. Stage Payload JSON holds fingerprint, staged receipt and optional published queue source and playlist version. Commit Payload holds approved command and original publication receipt. Direct Payload is serialized JSON null." "Desktop LiteDB Entity"
        desktopBatchImportCopy = element "Desktop / library_batch_import_copies" "LiteDB collection" "_id: (LibraryId, OriginInstanceId, OperationId). ScopeKey: LibraryId and OriginInstanceId. OperationId: Guid. Owns a private staged folder until the corresponding import entry is retired." "Desktop LiteDB Entity"
        desktopCheckpoint = element "Desktop / sync_checkpoints" "LiteDB collection" "_id: (LibraryId, Feed) for catalog; (LibraryId, OriginInstanceId, listener-outbox) for operation order. LibraryId: Guid. Feed: string. AppliedRevision or LastOrder: Int64. OriginInstanceId and LastSnapshotId: Guid?. SnapshotRequired: Boolean?." "Desktop LiteDB Entity"
        desktopSnapshot = element "Desktop / catalog_snapshot_stages" "LiteDB collection" "_id: (LibraryId, InstanceId). SnapshotId: Guid. UpperRevision and ExpectedCursor: Int64. TotalCount and ReceivedCount: Int32." "Desktop LiteDB Entity"
        desktopSnapshotRow = element "Desktop / catalog_snapshot_stage_rows" "LiteDB collection" "_id: (LibraryId, InstanceId, Offset). Owner: library and instance key. Payload: source revision and versioned entity." "Desktop LiteDB Entity"
        desktopSchema = element "Desktop / store_schema" "LiteDB collection" "_id: singleton 'store'. StoreId: Guid and stable identity of the single playback session in this local store. StoreRole: Desktop. SchemaVersion: Int32." "Desktop LiteDB Entity"

        hostArtist = element "Host / catalog_artists" "LiteDB collection" "_id: ArtistId (Guid). LibraryId: Guid. Revision: Int64. Name and SortName: string." "Host LiteDB Entity"
        hostAlbum = element "Host / catalog_albums" "LiteDB collection" "_id: AlbumId (Guid). LibraryId: Guid. AlbumArtistId: Guid?. Revision: Int64. BeetsAlbumId: Int64?. Title and SortTitle: string." "Host LiteDB Entity"
        hostTrack = element "Host / catalog_tracks" "LiteDB collection" "_id: TrackId (Guid). LibraryId: Guid. ArtistId and AlbumId: Guid?. Revision: Int64. BeetsTrackId: Int64?. Title, SortTitle, RelativePath and Genre: string?. TagAlbum and TagAlbumArtist: optional string overrides. An omitted override inherits the album value and an explicit null clears it. TrackNumber, DiscNumber, Year, and Rating: Int32?. DurationTicks: Int64?." "Host LiteDB Entity"
        hostPlaylist = element "Host / saved_playlists" "LiteDB collection" "_id: PlaylistId (Guid). LibraryId: Guid. Revision: Int64. Name: string. Entries: ordered { EntryId: Guid, TrackId: Guid } list." "Host LiteDB Entity"
        hostListening = element "Host / listening_records" "LiteDB collection" "_id: stable PlayId or derived library and track Guid for favorites. LibraryId, ListenerId and TrackId: Guid. The shared profile is the library ID. Kind: Play or Favorite. Revision: Int64. PlayedAtUtcTicks: Int64 for plays. Deleted: Boolean on retained tombstones." "Host LiteDB Entity"
        hostPreference = element "Host / shared_preferences" "LiteDB collection" "_id: Guid derived from library and preference key. LibraryId: Guid. Kind: SharedDefault. PreferenceKey: string. RegistryVersion: Int32. Revision: Int64. Live records contain exactly one of DurationTicks: Int64, Flag: Boolean, or Text: string. Deleted: Boolean on retained tombstones." "Host LiteDB Entity"
        hostInstance = element "Host / registered_instances" "LiteDB collection" "_id: InstanceId (Guid). LibraryId: Guid. Role and Status: string. Enrolled desktops have Name and AccessRole (Operator or Listener). LastSeenUtcTicks: optional Int64, updated separately from the registry revision. SyncthingDeviceId and PendingMediaPairing: string?. AndroidExport: optional { Revision: Int64, ShareId and ReceiverEndpoint: string, CaseSensitivePaths: Boolean, ReceiverRoot, ApprovedSenderId and InitialProfileId: string?, InitialProfileRevision: Int64?, ReceiverAcceptedAtOffer: Boolean?, ReceiverSharePhase and ReceiverFailureCode: string? }." "Host LiteDB Entity"
        hostDesktopRegistryHead = element "Host / desktop_registry_heads" "LiteDB collection" "_id: LibraryId (Guid). Revision: Int64. Advances with enrollment or revocation in the same transaction as the instance and operation receipt." "Host LiteDB Entity"
        hostBeetsSetup = element "Host / beets_library_setup" "LiteDB collection" "_id: LibraryId (Guid). Revision: Int64. Pending JSON: Origin and Operation Guid, Fingerprint, optional Prepared with StageId (Guid) and catalog and configuration SHA-256. Configuration JSON: provisioned catalog, YAML and music paths, naming template, import behavior, and selected approved plugin IDs." "Host LiteDB Entity"
        hostJob = element "Host / library_jobs" "LiteDB collection" "_id: JobId (Guid). LibraryId, OriginInstanceId, and OperationId: Guid. Kind and Status: string. Revision: Int64. UploadId: Guid?. Review JSON: ordered sources, edition and tag comparison, public match IDs and private release track identities. ApprovedChoice BSON: OperationId and ReviewItemId: Guid, ReviewRevision: Int64, Decision: string, ProviderKey: string?, and NativeMatch: optional approved native match JSON. NativeAttempted: Boolean?, default false. NativePreparation JSON: private matched copy paths, sizes and hashes in source order. TrackTagEdit: TrackId (Guid), ExpectedTrackRevision and BeetsTrackId (Int64), RelativePath (string), and TagChanges and TagBaseline (JSON strings). LibraryMaintenance: MaintenancePlanId (Guid), MaintenanceMode (string), AudioDeletionApproved (Boolean). OrganizationCopies JSON: ordered approved track, destination, source length and SHA-256. FailedFromPhase and FailureCode: string?. Retryable: Boolean?. ExpectedRevision and PublishedRevision: Int64?. PublicationFingerprint: SHA-256 of the reconciled album observation." "Host LiteDB Entity"
        hostMaintenancePlan = element "Host / library_maintenance_plans" "LiteDB collection" "_id: PlanId (Guid). LibraryId and OriginInstanceId: Guid. Plan JSON: kind, catalog revision, ordered track IDs and exact moves or audio paths. Targets JSON: ordered track ID, native beets ID, revision, and relative source path. AudioFiles JSON: ordered reviewed path, length and SHA-256 for explicit audio deletion. JobId or BatchOperationId: Guid? identifying the accepted execution path." "Host LiteDB Entity"
        hostBatchPublication = element "Host / library_batch_publications" "LiteDB collection" "_id: (OriginInstanceId, OperationId). BatchKey: unique library, desktop and batch ID. LibraryId, OriginInstanceId, OperationId, BatchId and ReviewId: Guid. BatchRevision: Int64. EntryCount and ImportPartCount: Int32. Phase: Accepted, Running, Published, Rejected or Withdrawn. Status JSON carries the authoritative phase and result. A withdrawal can reserve an approval before admission. NextPosition: Int32. EntryAttempted: Boolean. LockedPlaylists: Guid array during execution." "Host LiteDB Entity"
        hostBatchEntry = element "Host / library_batch_publication_entries" "LiteDB collection" "_id: (PublicationKey, Position). PublicationKey: (OriginInstanceId, OperationId). Position: Int32. EntryOperationId: Guid. Kind: typed change discriminator. Payload JSON: exact approved effects. Optional TagTarget pins track revision, beets ID and path. Optional OrganizationCopies records approved paths and source fingerprints. Optional TaggedFile records length and SHA-256 after verified tag edits. Optional ImportReview JSON carries album candidates and private match identities. ImportReviewRevision: Int64 when reviewed. Optional ImportChoice JSON records the approved action and receipt. Optional PreparedImport JSON pins matched copy hashes. Optional ObservedImport JSON binds native album and track readback to the choice operation. An approval withdrawn before admission has no entries." "Host LiteDB Entity"
        hostBatchImportPart = element "Host / library_batch_import_parts" "LiteDB collection" "_id: (PublicationKey, Position, Index). PublicationKey: (OriginInstanceId, OperationId). Position and Index: Int32. Receipt JSON: library, origin, approval, entry, and file IDs and ordinals. Recorded after the approved hash and size verify." "Host LiteDB Entity"
        hostImportUpload = element "Host / import_uploads" "LiteDB collection" "_id: (LibraryId, OriginInstanceId, UploadId). All three IDs: Guid. Files: ordered name, byte size and SHA-256 records. JobId: Guid?, set once after all private copies verify." "Host LiteDB Entity"
        hostReceipt = element "Host / operation_receipts" "LiteDB collection" "_id: (OriginInstanceId, OperationId). Both IDs: Guid. IntentFingerprint: string. Receipt: BSON document with Type: string, Version: Int32, and operation-specific fields. Result is JSON for receipt types that store a serialized outcome. PlaylistSaved carries SourceKind: Int32, SourceId and PlaylistId: Guid, and PlaylistRevision and FeedRevision: Int64." "Host LiteDB Entity"
        hostRevision = element "Host / revision_heads" "LiteDB collection" "_id: LibraryId (Guid). CurrentRevision and MinRetainedRevision: Int64." "Host LiteDB Entity"
        hostChange = element "Host / revision_changes" "LiteDB collection" "_id: (LibraryId, Revision). LibraryId, OriginInstanceId and OperationId: Guid. Revision: Int64. Changes: versioned entity updates or tombstones. A Track Delete payload identifies _id, LibraryId and removal Revision." "Host LiteDB Entity"
        hostDelivery = element "Host / notification_deliveries" "LiteDB collection" "_id: (LibraryId, Revision, RecipientInstanceId). Both IDs: Guid. Revision: Int64. Status: Pending or Acknowledged." "Host LiteDB Entity"
        hostSnapshot = element "Host / catalog_replica_snapshots" "LiteDB collection" "_id: (LibraryId, RecipientInstanceId). LibraryId, RecipientInstanceId and SnapshotId: Guid. ExpectedCursor and UpperRevision: Int64. TotalCount: Int32." "Host LiteDB Entity"
        hostSnapshotRow = element "Host / catalog_replica_snapshot_rows" "LiteDB collection" "_id: (LibraryId, RecipientInstanceId, Offset). Owner: library and recipient key. Payload: source revision and versioned entity." "Host LiteDB Entity"
        hostExport = element "Host / device_exports" "LiteDB collection" "_id: ExportId (Guid). LibraryId and DeviceId: Guid. ScopeKey: unique library, device and profile key. ShareId and ProfileId: string. ProfileVersion and ManifestRevision (staged revision): Int64. CaseSensitivePaths: Boolean. PublicationState: string. PreparedPreviewIdentity: optional SHA-256 digest of the private preview descriptor." "Host LiteDB Entity"
        hostExportEntry = element "Host / device_export_entries" "LiteDB collection" "_id: (ExportId, hash(PathKey)). ExportId, EntryId and SourceEntityId: Guid. RelativePath and PathKey: string. Ordinal: Int32. SourceKind: Playlist or Audio. Playlist: Format: string, ContentIdentity: string?, and ordered Tracks: { TrackId: Guid, Destination: string, AudioStatus: Int32 } references. Audio: AudioStatus: Int32 and optional IsDirect: Boolean. An absent IsDirect is false and the audio remains a playlist dependency." "Host LiteDB Entity"
        hostExportManifest = element "Host / device_export_manifests" "LiteDB collection" "_id: (LibraryId, DeviceId, hash(ShareId)). LibraryId, DeviceId and PublicationId: Guid. ShareId: string. Revision: Int64. Active layout: ProfileId and ProfileRevision, optional on legacy manifests." "Host LiteDB Entity"
        hostExportOwnedFile = element "Host / device_export_owned_files" "LiteDB collection" "_id: (ManifestKey, hash(PathKey)). ManifestKey, PathKey, RelativePath and ContentIdentity: string. SourceEntityId: Guid. SourceKind: Int32." "Host LiteDB Entity"
        hostExportJournal = element "Host / device_export_publication_journal" "LiteDB collection" "_id: PublicationId (Guid). ManifestKey: unique share scope. LibraryId, DeviceId, PlanId, OriginInstanceId and OperationId: Guid. ProfileId: string. PlanRevision, ProfileRevision and ManifestRevision: Int64. Destination: receiver registration snapshot. NextStep, StepCount and OwnedFileCount: Int32. LayoutEntryCount: optional Int32. NextProfileId and NextProfileRevision: optional reviewed assignment committed after file effects." "Host LiteDB Entity"
        hostExportJournalItem = element "Host / device_export_publication_items" "LiteDB collection" "_id: (PublicationId, Kind, Ordinal). PublicationId: Guid. Kind: Step, NextOwned or LayoutEntry. Ordinal: Int32. Payload: versioned file operation, owned file, or reviewed staged entry and playlist digest." "Host LiteDB Entity"
        hostExportScan = element "Host / device_export_scans" "LiteDB collection" "_id: TransferId (the PublicationId, Guid). ManifestKey: registered share scope. LibraryId and PlanId: Guid. PlanRevision, ManifestRevision and Revision: Int64. Destination: receiver registration snapshot. State: queued, awaiting receiver, completed, blocked, or superseded. Attempts and optional ItemCount: Int32. BytesVerified, optional TotalBytes, DueUtcTicks and optional LeaseUntilUtcTicks: Int64. Optional LeaseId and FailureCode." "Host LiteDB Entity"
        hostExportScanItem = element "Host / device_export_scan_items" "LiteDB collection" "_id: (TransferId, hash(Path)). TransferId: Guid. Path: string. ContentIdentity: SHA-256 of the requested file, or null for removal. Bytes and Version: optional sender index evidence pinned before observing the receiver." "Host LiteDB Entity"
        hostPcMirrorState = element "Host / pc_mirror_states" "LiteDB collection" "_id: LibraryId (Guid). Revision: Int64 for the projection. Observations: by ShareId, with native scope fingerprint, control revision, connection generation, last verified status and progress, and optional pending operation key." "Host LiteDB Entity"
        hostSchema = element "Host / store_schema" "LiteDB collection" "_id: singleton 'store'. StoreId: Guid. StoreRole: Host. SchemaVersion: Int32." "Host LiteDB Entity"

        desktopAlbum -> desktopArtist "Optional AlbumArtistId"
        desktopTrack -> desktopArtist "Optional ArtistId"
        desktopTrack -> desktopAlbum "Optional AlbumId"
        desktopPlaylist -> desktopTrack "Ordered entries by TrackId"
        desktopListening -> desktopTrack "TrackId"
        desktopDraft -> desktopPlaylist "Optional target PlaylistId"
        desktopDraft -> desktopTrack "Ordered draft entries by TrackId"
        desktopPlayback -> desktopTrack "Ordered queue entries by TrackId"
        desktopPlayback -> desktopOperation "Commits an observed play and its original operation with the playback checkpoint"
        desktopOperation -> desktopDraft "Optional DraftId retained for reconciliation"
        desktopOperation -> desktopPlayback "Optional QueueSessionId for ordered auto-save replay"
        desktopPlayback -> desktopBatchReceipt "Reconciles staged auto-save and published playlist version by BatchId and OperationId"
        desktopCheckpoint -> desktopArtist "Commits with the applied artist page"
        desktopCheckpoint -> desktopAlbum "Commits with the applied album page"
        desktopCheckpoint -> desktopTrack "Commits with the applied track page"
        desktopCheckpoint -> desktopPlaylist "Commits with the applied playlist page"
        desktopCheckpoint -> desktopListening "Commits with the applied listening records"
        desktopOperation -> desktopCheckpoint "Allocates the listener operation order in the staging transaction"
        desktopCheckpoint -> desktopSharedPreference "Commits with the applied shared defaults"
        desktopSnapshotRow -> desktopSnapshot "Owner and contiguous position identify pending data"
        desktopSnapshot -> desktopCheckpoint "LastSnapshotId and upper revision commit with complete catalog replacement"
        desktopOverride -> desktopSharedPreference "Resolves the next preference source by key"

        desktopBatchMode -> desktopBatchEntry "BatchId and positions from 1 through ChangeCount"
        desktopBatchReceipt -> desktopBatchMode "Origin scope and batch version"
        desktopBatchEntry -> desktopBatchReceipt "OperationId identifies the staged intent"
        desktopBatchImportCopy -> desktopBatchEntry "OperationId identifies the active ordered import manifest"
        hostAlbum -> hostArtist "Optional AlbumArtistId"
        hostTrack -> hostArtist "Optional ArtistId"
        hostTrack -> hostAlbum "Optional AlbumId"
        hostPlaylist -> hostTrack "Ordered entries by TrackId"
        hostListening -> hostTrack "TrackId"
        hostJob -> hostInstance "OriginInstanceId"
        hostJob -> hostTrack "TrackId and expected track revision for a tag edit"
        hostMaintenancePlan -> hostTrack "Selected track IDs and catalog revisions"
        hostJob -> hostMaintenancePlan "MaintenancePlanId binds the reviewed effects"
        hostBatchEntry -> hostBatchPublication "PublicationKey and Position identify the reviewed entry"
        hostBatchImportPart -> hostBatchEntry "PublicationKey and Position bind the exact verified file manifest"
        hostBatchPublication -> hostReceipt "Approval, withdrawal and per-entry operation reservations"
        hostBatchPublication -> hostPlaylist "LockedPlaylists prevents competing edits during native execution"
        hostMaintenancePlan -> hostBatchPublication "BatchOperationId reserves the plan for the approved batch"
        hostBatchEntry -> hostMaintenancePlan "Maintenance plan supplies the independently approved audio paths and fingerprints"
        hostImportUpload -> hostInstance "OriginInstanceId"
        hostImportUpload -> hostJob "JobId after accepted upload"
        hostJob -> hostReceipt "Submission and review decision receipts by origin and operation ID"
        hostJob -> hostChange "PublishedRevision when reconciled"
        hostReceipt -> hostInstance "OriginInstanceId"
        hostReceipt -> hostDesktopRegistryHead "Registry revision in an enrollment or revocation receipt"
        hostReceipt -> hostBeetsSetup "Setup or configuration operation and the committed revision"
        hostReceipt -> hostChange "Feed revision in a playlist save receipt"
        hostReceipt -> hostExport "Plan ID and original plan revision in a device staging receipt"
        hostChange -> hostRevision "LibraryId and issued revision"
        hostChange -> hostPlaylist "Versioned playlist updates"
        hostChange -> hostTrack "Track upserts and deletion tombstones"
        hostDelivery -> hostChange "LibraryId and revision to deliver"
        hostDelivery -> hostInstance "RecipientInstanceId"
        hostSnapshot -> hostInstance "RecipientInstanceId identifies the only authorized reader"
        hostSnapshot -> hostRevision "UpperRevision pins the captured catalog"
        hostSnapshotRow -> hostSnapshot "Owner and offset identify an immutable captured record"
        hostExport -> hostInstance "Registered DeviceId"
        hostExportEntry -> hostExport "ExportId"
        hostExportEntry -> hostPlaylist "SourceEntityId when SourceKind is Playlist"
        hostExportEntry -> hostTrack "SourceEntityId when SourceKind is Audio"
        hostExportManifest -> hostInstance "Registered DeviceId"
        hostExportOwnedFile -> hostExportManifest "ManifestKey"
        hostExportOwnedFile -> hostPlaylist "SourceEntityId when SourceKind is Playlist"
        hostExportOwnedFile -> hostTrack "SourceEntityId when SourceKind is Audio"
        hostExportJournal -> hostExport "PlanId and recorded plan revision"
        hostExportJournal -> hostExportManifest "ManifestKey and base ownership revision"
        hostExportJournalItem -> hostExportJournal "PublicationId"
        hostExportScan -> hostExportManifest "ManifestKey and queued ownership revision"
        hostExportScan -> hostExport "PlanId and published plan revision"
        hostExportScanItem -> hostExportScan "TransferId and exact published effects"
        hostReceipt -> hostExportJournal "Reservation receipt before file effects"
        hostReceipt -> hostExportManifest "Committed device publication and manifest revision"
        hostReceipt -> hostPcMirrorState "Pending and completed PC mirror controls"
        hostReceipt -> hostInstance "Pairing reservation key and the committed Android export binding"
        hostPcMirrorState -> hostInstance "Directory revision advances with changes in verified Android folder status"
