{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    },
    "RollingFile": {
      "Enabled": true,
      "Directory": "${AppData}/logs",
      "RetainedFileCount": 14
    }
  },
  "Storage": {
    "LiteDbPath": "${AppData}/data/beets-man.db"
  },
  "Library": {
    "LocalMusicRoot": "${Music}"
  }
}
